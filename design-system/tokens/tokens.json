{
  "$description": "Generated by scripts/sync-tokens.mjs from src/app/globals.css. Do not edit.",
  "primitives": {
    "ease": {
      "out": {
        "quart": {
          "$type": "cubicBezier",
          "$value": "cubic-bezier(0.165, 0.84, 0.44, 1)"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "tracking": {
      "tightest": {
        "$type": "dimension",
        "$value": "-0.025em"
      },
      "tighter": {
        "$type": "dimension",
        "$value": "-0.02em"
      }
    },
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "Geist"
        },
        "mono": {
          "$type": "fontFamily",
          "$value": "Geist Mono"
        }
      }
    },
    "shadow": {
      "subtle": {
        "$type": "shadow",
        "$value": "0px 0px 0px 1px rgba(9, 9, 11, 0.08), 0px 1px 2px -1px rgba(9, 9, 11, 0.08), 0px 2px 4px 0px rgba(9, 9, 11, 0.04)"
      }
    }
  },
  "semantic": {
    "background": {
